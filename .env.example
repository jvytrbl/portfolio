# Copy to .env.local (never commit it). Every value below is optional for local
# development — features whose keys are missing show a "not configured" state.

# Public URL of the deployed site (metadata, sitemap, OG images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Connect → "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Resend → API Keys → "Sending access" key (starts with re_).
RESEND_API_KEY=
# Where contact notifications are delivered. Must be your Resend sign-up
# address until you verify your own domain in Resend.
CONTACT_TO_EMAIL=hakimiazizi060@gmail.com

# Cloudflare → Turnstile → your widget. For local testing you can use
# Cloudflare's always-pass test keys:
#   site:   1x00000000000000000000AA
#   secret: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional GitHub personal access token (no scopes needed) — raises the API
# rate limit and enables pinned repositories + the contribution graph.
GITHUB_TOKEN=
